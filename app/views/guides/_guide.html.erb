<div id="<%= dom_id guide %>" class="card flex-row border-0 border-end">
  <% if guide.image.attached? %>
    <%= image_tag guide.image.variant(resize_to_limit: [ 400, 400 ]), class: "rounded-start flex-shrink-0", style: "width: 180px; object-fit: cover;" %>
  <% end %>

  <div class="card-body d-flex flex-column flex-grow-1" style="min-width: 0;">
    <h3 class="card-title h5">
      <%= link_to guide.title, guide, class: "text-decoration-none text-dark" %>
      <% unless guide.published? %>
        <span class="badge text-bg-warning">Draft</span>
      <% end %>
    </h3>
    <p class="card-text text-secondary"><%= truncate(guide.description.to_s, length: 150, separator: " ") %></p>

    <div class="d-flex gap-2 align-items-center">
      <p class="card-text mb-0">
        <small class="text-muted"><%= pluralize(guide.steps.size, "step") %></small>
      </p>
      |
      <%= link_to "Read guide →", guide, class: "link" %>
    </div>
  </div>
</div>
