<% content_for :title, "Guides" %>

<% if notice.present? %>
  <p class="alert alert-success"><%= notice %></p>
<% end %>

<% if admin_signed_in? %>
  <div class="text-end mb-2">
    <%= link_to admin_guides_path, class: "text-decoration-none text-secondary small d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-pencil"></i>
      Manage guides
    <% end %>
  </div>
<% end %>

<h1 class="h1">Guides</h1>
<hr>

<div id="guides" class="d-flex flex-column gap-4 pt-2">
  <% @guides.each do |guide| %>
    <%= render guide %>
  <% end %>
</div>

<% if @guides.none? %>
  <p class="text-muted">No guides yet.</p>
<% end %>
