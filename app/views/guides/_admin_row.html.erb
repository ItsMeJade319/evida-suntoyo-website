<div class="admin-list-item">
  <% if guide.image.attached? %>
    <%= image_tag guide.image.variant(resize_to_limit: [ 80, 80 ]), class: "admin-thumb" %>
  <% else %>
    <div class="admin-thumb-placeholder"><i class="bi bi-image"></i></div>
  <% end %>

  <div class="flex-grow-1" style="min-width: 0;">
    <%= link_to guide.to_s.presence || "Guide ##{guide.id}", guide_path(guide), class: "d-block text-body text-decoration-none fw-semibold text-truncate" %>
    <div class="d-flex align-items-center gap-2">
      <span class="badge <%= guide.published? ? "text-bg-success" : "text-bg-warning" %>"><%= guide.published? ? "Published" : "Draft" %></span>
      <span class="text-muted small"><%= pluralize(guide.steps.size, "step") %></span>
    </div>
  </div>

  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to edit_guide_path(guide, return_to: request.original_fullpath), class: "btn btn-sm btn-outline-secondary" do %>
      <i class="bi bi-pencil"></i>
    <% end %>
    <%= button_to guide_path(guide, return_to: request.original_fullpath), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } } do %>
      <i class="bi bi-trash"></i>
    <% end %>
  </div>
</div>
