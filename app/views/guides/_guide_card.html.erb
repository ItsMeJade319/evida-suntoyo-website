<div id="<%= dom_id guide %>" class="card h-100">
  <% if guide.image.attached? %>
    <%= image_tag guide.image.variant(resize_to_limit: [ 400, 400 ]), class: "card-img-top", style: "height: 240px; object-fit: cover;" %>
  <% end %>

  <div class="card-body d-flex flex-column p-4">
    <h3 class="card-title h5">
      <%= link_to guide.title, guide, class: "text-decoration-none text-dark" %>
      <% unless guide.published? %>
        <span class="badge text-bg-warning">Draft</span>
      <% end %>
    </h3>
    <p class="body-sm flex-grow-1"><%= truncate(guide.description.to_s, length: 160, separator: " ") %></p>

    <div class="d-flex gap-2 align-items-center">
      <span class="caption"><%= pluralize(guide.steps.size, "step") %></span>
      <%= link_to "Read guide →", guide, class: "link" %>
    </div>
  </div>
</div>
