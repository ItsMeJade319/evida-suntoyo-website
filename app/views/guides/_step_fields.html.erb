<div class="step-fields border rounded p-3 mb-2" data-nested-fields-target="fields">
  <div class="mb-2">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-2">
    <%= form.label :content, class: "form-label" %>
    <%= form.text_area :content, class: "form-control", rows: 4 %>
  </div>

  <div class="mb-2">
    <%= form.label :image, class: "form-label" %>
    <% if form.object.image.attached? %>
      <div class="mb-2">
        <%= image_tag form.object.image.variant(resize_to_limit: [ 150, 150 ]), class: "img-thumbnail" %>
      </div>
    <% end %>
    <%= form.file_field :image, class: "form-control", accept: "image/*" %>
  </div>

  <%= form.hidden_field :_destroy %>
  <button type="button" class="btn btn-outline-danger btn-sm" data-action="nested-fields#remove">Remove step</button>
</div>
