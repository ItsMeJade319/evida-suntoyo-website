<% content_for :title, "Blog" %>

<% if notice.present? %>
  <p class="alert alert-success"><%= notice %></p>
<% end %>

<% if admin_signed_in? %>
  <div class="text-end mb-2">
    <%= link_to admin_posts_path, class: "text-decoration-none text-secondary small d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-pencil"></i>
      Manage posts
    <% end %>
  </div>
<% end %>

<div class="text-center py-3">
  <h1 class="mb-4 text-uppercase text-bolder">Blog</h1>
  <hr>
</div>

<div id="posts" class="row row-cols-1 row-cols-md-2 g-4">
  <% @posts.each do |post| %>
    <%= render post %>
  <% end %>
</div>

<% if @posts.none? %>
  <p class="text-muted">No posts yet.</p>
<% end %>
