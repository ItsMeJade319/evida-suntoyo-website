<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul class="mb-0">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :slug, class: "form-label" %>
    <%= form.text_field :slug, class: "form-control", placeholder: "auto-generated from title if left blank" %>
  </div>

  <div class="mb-3">
    <%= form.label :body, class: "form-label" %>
    <%= form.text_area :body, class: "form-control", rows: 10 %>
  </div>

  <div class="mb-3">
    <%= form.label :image, class: "form-label" %>
    <% if post.image.attached? %>
      <div class="mb-2">
        <%= image_tag post.image.variant(resize_to_limit: [ 200, 200 ]), class: "img-thumbnail" %>
      </div>
    <% end %>
    <%= form.file_field :image, class: "form-control", accept: "image/*" %>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :published, class: "form-check-input" %>
    <%= form.label :published, class: "form-check-label" %>
  </div>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
