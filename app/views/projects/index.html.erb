<% content_for :title, "Portfolio" %>

<% if notice.present? %>
  <p class="alert alert-success"><%= notice %></p>
<% end %>

<h1 class="mb-4">Portfolio</h1>

<div id="projects" class="row row-cols-1 row-cols-md-2 g-3">
  <% @projects.each do |project| %>
    <div class="col">
      <%= render project %>
    </div>
  <% end %>
</div>

<% if @projects.none? %>
  <p class="text-muted">No projects yet.</p>
<% end %>
