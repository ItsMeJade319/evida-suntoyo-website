<%= form_with(model: project) do |form| %>
  <% if project.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>

      <ul class="mb-0">
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="mb-3">
    <%= form.label :tech_stack, "Tech stack", class: "form-label" %>
    <%= form.text_field :tech_stack, class: "form-control", placeholder: "Ruby on Rails, Bootstrap, PostgreSQL" %>
  </div>

  <div class="mb-3">
    <%= form.label :project_link, "Project link", class: "form-label" %>
    <%= form.url_field :project_link, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :repo_link, "Repo link", class: "form-label" %>
    <%= form.url_field :repo_link, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :position, class: "form-label" %>
    <%= form.number_field :position, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :image, class: "form-label" %>
    <% if project.image.attached? %>
      <div class="mb-2">
        <%= image_tag project.image.variant(resize_to_limit: [ 200, 200 ]), class: "img-thumbnail" %>
      </div>
    <% end %>
    <%= form.file_field :image, class: "form-control", accept: "image/*" %>
  </div>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
