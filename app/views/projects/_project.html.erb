<div id="<%= dom_id project %>" class="card mb-3">
  <% if project.image.attached? %>
    <%= image_tag project.image.variant(resize_to_limit: [ 600, 400 ]), class: "card-img-top" %>
  <% end %>

  <div class="card-body">
    <h3 class="card-title"><%= project.title %></h3>
    <p class="card-text"><%= project.description %></p>
    <% if project.tech_stack.present? %>
      <p class="card-text"><small class="text-muted"><%= project.tech_stack %></small></p>
    <% end %>

    <div class="d-flex gap-2">
      <% if project.project_link.present? %>
        <%= link_to "Live", project.project_link, class: "btn btn-sm btn-primary", target: "_blank", rel: "noopener" %>
      <% end %>
      <% if project.repo_link.present? %>
        <%= link_to "Source", project.repo_link, class: "btn btn-sm btn-outline-secondary", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  </div>
</div>
