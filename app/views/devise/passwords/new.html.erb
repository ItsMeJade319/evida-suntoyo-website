<% content_for :title, "Forgot your password?" %>

<div class="admin-auth-wrap">
  <div class="admin-auth-card">
    <p class="fs-4 fw-bold mb-1">Forgot your password?</p>
    <p class="text-secondary mb-4">We'll email you instructions to reset it.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <%= f.submit "Send me password reset instructions", class: "btn btn-primary w-100" %>
    <% end %>

    <div class="text-center mt-3">
      <%= link_to "Back to log in", new_session_path(resource_name), class: "text-decoration-none text-secondary small" %>
    </div>
  </div>
</div>
