<% if resource.errors.any? %>
  <div class="alert alert-danger">
    <p class="fw-bold mb-1"><%= pluralize(resource.errors.count, "error") %> prohibited this form from being saved:</p>
    <ul class="mb-0">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
