<div class="py-4">
  <div class="section-label">
    <p class="eyebrow mb-0">Recent guides</p>
    <%= link_to "View all guides →", guides_path, class: "link-lg" %>
  </div>

  <hr>

  <div class="row row-cols-1 row-cols-md-3 gx-3 gy-4 py-2">
    <% @recent_guides.each do |guide| %>
      <div class="col">
        <%= render "guides/guide_card", guide: guide %>
      </div>
    <% end %>
  </div>
</div>
