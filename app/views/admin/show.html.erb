<% content_for :title, "Admin dashboard" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Admin dashboard</h1>
  <div class="d-flex align-items-center gap-2">
    <span class="text-muted"><%= current_admin.email %></span>
    <%= button_to "Sign out", destroy_admin_session_path, method: :delete, class: "btn btn-sm btn-outline-secondary" %>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h4 mb-0">Projects (<%= @projects.size %>)</h2>
      <%= link_to "New project", new_project_path, class: "btn btn-sm btn-primary" %>
    </div>
    <ul class="list-group mb-4">
      <% @projects.each do |project| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to project.to_s.presence || "Project ##{project.id}", project_path(project) %>
          <span>
            <%= link_to "Edit", edit_project_path(project), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "Delete", project_path(project), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
          </span>
        </li>
      <% end %>
      <% if @projects.none? %>
        <li class="list-group-item text-muted">No projects yet.</li>
      <% end %>
    </ul>
  </div>

  <div class="col-md-6">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h4 mb-0">Posts (<%= @posts.size %>)</h2>
      <%= link_to "New post", new_post_path, class: "btn btn-sm btn-primary" %>
    </div>
    <ul class="list-group mb-4">
      <% @posts.each do |post| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to post.to_s.presence || "Post ##{post.id}", post_path(post) %>
          <span>
            <%= link_to "Edit", edit_post_path(post), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "Delete", post_path(post), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
          </span>
        </li>
      <% end %>
      <% if @posts.none? %>
        <li class="list-group-item text-muted">No posts yet.</li>
      <% end %>
    </ul>
  </div>
</div>
